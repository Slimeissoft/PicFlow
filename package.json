{
  "name": "picflow",
  "productName": "PicFlow",
  "version": "1.6.3",
  "description": "本地图片整理与管理桌面应用（云端 AI 识别 + 本地 NSFW 过滤）",
  "main": "main.js",
  "author": "PicFlow",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "electron-updater": "^6.8.9",
    "nsfwjs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.picflow.imageManager",
    "productName": "PicFlow",
    "copyright": "Copyright © 2026 PicFlow",
    "publish": {
      "provider": "github",
      "owner": "Slimeissoft",
      "repo": "PicFlow",
      "releaseType": "release"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "scanner.js",
      "db.js",
      "ai.js",
      "cloudai.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "PicFlow-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PicFlow",
      "uninstallDisplayName": "PicFlow"
    },
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "artifactName": "PicFlow-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "PicFlow ${version}",
      "artifactName": "PicFlow-${version}-${arch}.${ext}"
    }
  }
}
