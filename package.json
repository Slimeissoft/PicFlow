{
  "name": "picflow",
  "productName": "PicFlow 图片管家",
  "version": "1.4.0",
  "description": "本地图片整理与管理桌面应用（云端 AI 识别 + 本地 NSFW 过滤）",
  "main": "main.js",
  "author": "PicFlow",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "electron-updater": "^6.8.9",
    "nsfwjs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.picflow.imageManager",
    "productName": "PicFlow 图片管家",
    "copyright": "Copyright © 2026 PicFlow",
    "publish": {
      "provider": "github",
      "owner": "Slimeissoft",
      "repo": "PicFlow",
      "releaseType": "release"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "scanner.js",
      "db.js",
      "ai.js",
      "cloudai.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PicFlow 图片管家",
      "uninstallDisplayName": "PicFlow 图片管家"
    }
  }
}
